            "description": {
              "content": "Ingests JSON-encoded OTLP/HTTP spans. Use an OTEL exporter configured for the otlphttp protocol with JSON encoding and no compression, and set the x-api-key header to a project-level API key. Available on Langtrace Cloud and self-hosted instances.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "trace"
              ],
              "host": [
                "{{baseUrl}}"
              ],
